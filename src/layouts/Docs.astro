---
import Base from './Base.astro';
import { KOK_DOCS, KOK_DOC_FLAT } from '../data/kok-docs';

interface Props {
  title: string;
  description?: string;
  current?: string;
  isHome?: boolean;
}

const { title, description, current = Astro.url.pathname, isHome = false } = Astro.props;
const normalize = (href: string) => (href.endsWith('/') ? href : `${href}/`);
const active = normalize(current);
const flat = KOK_DOC_FLAT;
const index = flat.findIndex((page) => normalize(page.href) === active);
const prev = index > 0 ? flat[index - 1] : null;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : null;
const pageTitle = isHome ? title : `${title} · kok 帮助中心`;
const pageDescription = description ?? 'kok 帮助中心：安装、Agent、我的作品、资料库、设置与参考。';
---

<Base title={pageTitle} description={pageDescription}>
  <div class="wrap docs-shell">
    <aside class="docs-side">
      <a class="docs-home" href="/docs/kok/" aria-current={isHome ? 'page' : undefined}>
        <span class="docs-kicker mono">// kok docs</span>
        <b>帮助中心</b>
      </a>

      <nav class="docs-nav" aria-label="kok 帮助目录">
        {
          KOK_DOCS.map((section) => (
            <div class="docs-group">
              <span class="docs-group-title mono">{section.title}</span>
              {section.pages.map((page) => (
                <a
                  href={page.href}
                  class:list={['docs-link', { active: normalize(page.href) === active }]}
                  aria-current={normalize(page.href) === active ? 'page' : undefined}
                >
                  {page.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>

      <a class="docs-back mono" href="/projects/kok/">← kok 项目页</a>
    </aside>

    <div class="docs-main">
      <details class="docs-mobile">
        <summary>
          <span>目录</span>
          <span class="docs-mobile-current">{isHome ? '帮助中心' : title}</span>
        </summary>
        <nav class="docs-mobile-nav" aria-label="kok 帮助目录（移动端）">
          <a href="/docs/kok/">帮助中心首页</a>
          {
            KOK_DOCS.map((section) => (
              <div class="docs-group">
                <span class="docs-group-title mono">{section.title}</span>
                {section.pages.map((page) => (
                  <a href={page.href}>{page.label}</a>
                ))}
              </div>
            ))
          }
        </nav>
      </details>

      {
        !isHome && (
          <nav class="docs-crumbs mono" aria-label="面包屑">
            <a href="/docs/kok/">kok 帮助中心</a>
            <span>/</span>
            <span>{title}</span>
          </nav>
        )
      }

      <article class="prose docs-prose">
        <h1 class="docs-title">{title}</h1>
        <slot />
      </article>

      {
        !isHome && (prev || next) && (
          <nav class="docs-pager" aria-label="上一页与下一页">
            {prev ? (
              <a class="docs-page-link prev" href={prev.href}>
                <span class="mono">← 上一页</span>
                <b>{prev.label}</b>
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="docs-page-link next" href={next.href}>
                <span class="mono">下一页 →</span>
                <b>{next.label}</b>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }

      <div class="docs-foot mono">
        <a href="/projects/kok/">← 返回 kok 项目页</a>
        <a href="https://github.com/ChenShoukang/kok/tree/main/docs/help" target="_blank" rel="noreferrer">
          在 GitHub 查看帮助源文件 ↗
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 48px;
    padding-top: 48px;
    padding-bottom: 80px;
    align-items: start;
  }

  .docs-side {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-height: calc(100vh - 130px);
    overflow-y: auto;
    padding-right: 6px;
    scrollbar-width: thin;
  }

  .docs-home {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    box-shadow: 4px 4px 0 var(--shadow-c);
  }

  .docs-home .docs-kicker {
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .docs-home b {
    font: 700 19px var(--font-display);
  }

  .docs-nav {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .docs-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .docs-group-title {
    margin: 0 0 4px;
    padding: 0 10px;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .docs-link {
    padding: 5px 10px;
    border-radius: 8px;
    border-left: 2px solid transparent;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .docs-link:hover {
    background: var(--paper-2);
    color: var(--ink);
  }

  .docs-link.active {
    border-left-color: var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
    font-weight: 600;
  }

  .docs-back {
    padding: 8px 10px;
    font-size: 13px;
    color: var(--muted);
    border-top: 1.5px dashed var(--line);
  }

  .docs-back:hover {
    color: var(--accent);
  }

  .docs-main {
    min-width: 0;
  }

  .docs-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    font-size: 13px;
    color: var(--muted);
  }

  .docs-crumbs a {
    color: var(--accent);
  }

  .docs-prose {
    max-width: 820px;
  }

  .docs-prose :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(30px, 4.6vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
  }

  .docs-pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 56px 0 0;
    max-width: 820px;
  }

  .docs-page-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 48%;
    padding: 12px 16px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    box-shadow: 3px 3px 0 var(--shadow-c);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .docs-page-link:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--shadow-c);
  }

  .docs-page-link .mono {
    font-size: 12px;
    color: var(--muted);
  }

  .docs-page-link.next {
    text-align: right;
    margin-left: auto;
  }

  .docs-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin: 56px 0 0;
    padding-top: 16px;
    border-top: 1.5px dashed var(--line);
    max-width: 820px;
    font-size: 13px;
    color: var(--muted);
  }

  .docs-foot a:hover {
    color: var(--accent);
  }

  .docs-mobile {
    display: none;
    margin-bottom: 26px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    box-shadow: 4px 4px 0 var(--shadow-c);
  }

  .docs-mobile summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    cursor: pointer;
    font: 700 14px var(--font-mono);
    list-style: none;
  }

  .docs-mobile summary::-webkit-details-marker {
    display: none;
  }

  .docs-mobile-current {
    color: var(--muted);
    font-weight: 500;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .docs-mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 65vh;
    overflow-y: auto;
    padding: 0 16px 16px;
  }

  .docs-mobile-nav > a,
  .docs-mobile-nav .docs-link {
    font-size: 14px;
    padding: 4px 0;
  }

  @media (max-width: 900px) {
    .docs-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-top: 28px;
    }

    .docs-side {
      display: none;
    }

    .docs-mobile {
      display: block;
    }

    .docs-crumbs {
      margin-top: 4px;
    }

    .docs-pager {
      flex-direction: column;
    }

    .docs-page-link {
      max-width: 100%;
    }

    .docs-page-link.next {
      margin-left: 0;
    }
  }
</style>
