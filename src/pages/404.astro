---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <div class="wrap nf">
    <div class="code">404</div>
    <p class="mono">$ cd /this-page<br /><span>bash: cd: no such file or directory</span></p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
      <a href="/" class="btn">← 回到首页</a>
      <button class="btn" style="box-shadow:none;border-color:var(--line);color:var(--ink-2)" onclick="history.length > 1 ? history.back() : location.assign('/')">← 返回上一页</button>
    </div>
  </div>
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-align: center;
  }

  .code {
    font: 800 clamp(120px, 28vw, 260px) / 1 var(--font-display);
    letter-spacing: -0.06em;
    text-shadow: 8px 8px 0 var(--shadow-hover);
    animation: wobble 3s ease-in-out infinite;
  }

  p span {
    color: var(--accent);
  }

  @keyframes wobble {
    50% {
      transform: rotate(-2deg) translateY(-6px);
    }
  }
</style>
