---
import Base from '../layouts/Base.astro';
import { WORK_CATEGORIES } from '../data/works';
import { getCollection } from 'astro:content';

const entries = await getCollection('works', ({ data }) => import.meta.env.DEV || !data.draft);
const byCategory = (slug: string) =>
  entries.filter((e) => e.id.split('/')[0] === slug).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="作品" description="书、影、音：看过的、听过的，和自己写下的">
  <div class="wrap">
    <header class="page-head">
      <div class="kicker">// 3 shelves</div>
      <h1>作品<span style="color:var(--accent)">.</span></h1>
      <p>书、影、音：看过的、听过的，和自己写下的。</p>
    </header>

    <div class="shelves">
      {
        WORK_CATEGORIES.map((cat) => {
          const items = byCategory(cat.slug);
          const latest = items[0];
          return (
            <a class="shelf reveal" href={`/works/${cat.slug}/`}>
              <div class="top mono">
                <span class="name">{cat.name}</span>
                <span class="count">{items.length} {cat.unit}</span>
              </div>
              <ul class="kinds mono">
                {cat.kinds.map((k) => (
                  <li>{k.name}</li>
                ))}
              </ul>
              <div class="foot mono">
                {latest ? <span>最近：{latest.data.title}</span> : <span>还没有内容</span>}
                <span class="go">进入 ↗</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Base>

<style>
  .shelves {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 24px;
  }

  .shelf {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 240px;
    padding: 26px 24px;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: 5px 5px 0 var(--shadow-c);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .shelf:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--shadow-hover);
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .name {
    font: 800 46px/1 var(--font-display);
    letter-spacing: -0.04em;
  }

  .count {
    font-size: 12.5px;
    color: var(--accent);
  }

  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12.5px;
  }

  .kinds li {
    padding: 2px 9px;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    color: var(--ink-2);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1.5px dashed var(--line);
    font-size: 12.5px;
    color: var(--muted);
  }

  .foot span:first-child {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .go {
    color: var(--accent);
    font-weight: 600;
  }
</style>
