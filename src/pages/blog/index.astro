---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, slugify } from '../../utils';

const posts = await getPosts();
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) || []), p]);
}
---

<Base title="博客" description="所有文章">
  <div class="wrap">
    <header class="page-head">
      <div class="kicker">// archive · {posts.length} posts</div>
      <h1>全部文章<span style="color:var(--accent)">.</span></h1>
      <p>技术笔记、踩坑记录、读书和生活的碎碎念，按年份归档。</p>
      <label class="filter" hidden={posts.length === 0}>
        <span class="mono">filter:</span>
        <input id="filter" type="text" placeholder="标题 / 标签…" autocomplete="off" />
        <span id="count" class="mono"></span>
      </label>
    </header>

    {
      [...byYear.entries()].map(([year, list]) => (
        <section class="year" data-year>
          <h2 class="y">
            {year}
            <sup class="mono">{list.length}</sup>
          </h2>
          <ul>
            {list.map((p) => (
              <li
                class="row"
                data-key={`${p.data.title} ${p.data.tags.join(' ')} ${p.data.summary ?? ''}`.toLowerCase()}
              >
                <time class="mono">{formatDate(p.data.date).slice(5)}</time>
                <a href={`/posts/${p.id}`} class="t">
                  <span class="hl">{p.data.title}</span>
                </a>
                <span class="dots" aria-hidden="true" />
                <span class="tg">
                  {p.data.tags.slice(0, 2).map((t) => (
                    <a class="tag" href={`/tags/${slugify(t)}`}>
                      #{t}
                    </a>
                  ))}
                </span>
                <span class="rt mono">{readingTime(p.body)} 分钟</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    {posts.length === 0 && <div class="empty-state mono"><span>¯\_(ツ)_/¯</span><p>这里还空空如也，敬请期待。</p></div>}
    <p id="none" class="none mono" hidden>¯\_(ツ)_/¯ 没有匹配的文章</p>
  </div>
</Base>

<script>
  const input = document.getElementById('filter') as HTMLInputElement;
  const count = document.getElementById('count')!;
  const none = document.getElementById('none')!;
  const run = () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    document.querySelectorAll<HTMLElement>('[data-year]').forEach((sec) => {
      let any = false;
      sec.querySelectorAll<HTMLElement>('.row').forEach((r) => {
        const ok = !q || r.dataset.key!.includes(q);
        r.hidden = !ok;
        if (ok) (any = true), n++;
      });
      sec.hidden = !any;
    });
    count.textContent = q ? `找到 ${n} 篇` : '';
    none.hidden = n > 0;
  };
  input.addEventListener('input', run);
</script>

<style>
  .filter {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    max-width: 520px;
    padding: 10px 16px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    box-shadow: 4px 4px 0 var(--shadow-c);
    transition: box-shadow 0.2s;
  }

  .filter:focus-within {
    box-shadow: 4px 4px 0 var(--shadow-hover);
  }

  .filter span {
    color: var(--accent);
    font-size: 14px;
  }

  #count {
    color: var(--muted);
    white-space: nowrap;
  }

  .filter input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font: 16px var(--font-body);
    color: var(--ink);
  }

  .year {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
    margin-bottom: 48px;
  }

  .filter[hidden],
  .year[hidden],
  .row[hidden] {
    display: none;
  }

  .y {
    position: sticky;
    top: 100px;
    align-self: start;
    margin: 0;
    font: 800 48px/1 var(--font-display);
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
  }

  .y sup {
    font-size: 13px;
    color: var(--accent);
    -webkit-text-stroke: 0;
    vertical-align: top;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px dashed var(--line);
  }

  .row time,
  .rt {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  .t {
    font-weight: 600;
    font-size: 18px;
  }

  .dots {
    flex: 1;
    min-width: 20px;
  }

  .tg {
    display: flex;
    gap: 6px;
  }

  .none {
    text-align: center;
    color: var(--muted);
    padding: 40px;
  }

  @media (max-width: 760px) {
    .year {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .y {
      position: static;
      font-size: 36px;
    }
    .row {
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .t {
      flex-basis: 100%;
      order: -1;
    }
    .dots {
      display: none;
    }
  }
</style>
