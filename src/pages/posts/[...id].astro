---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, formatDate, readingTime, slugify, hueOf } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, date, tags, summary, cover } = post.data;
---

<Base title={title} description={summary}>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <article class="wrap post" style={`--h:${hueOf(post.id)}`}>
    <header class="post-head">
      <a href="/blog" class="back mono"><span class="hl">← 全部文章</span></a>
      <div class="meta mono">
        <time datetime={date.toISOString()}>{formatDate(date, true)}</time>
        <span>·</span>
        <span>约 {readingTime(post.body)} 分钟读完</span>
      </div>
      <h1>{title}</h1>
      {summary && <p class="lead">{summary}</p>}
      <div class="tags">{tags.map((t) => <a class="tag" href={`/tags/${slugify(t)}`}>#{t}</a>)}</div>
      {cover && <img class="cover" src={cover} alt="" />}
    </header>

    <div class="layout">
      <div class="prose">
        <Content />
      </div>

      {
        toc.length > 0 && (
          <aside class="toc">
            <div class="toc-title mono">目录</div>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`} data-slug={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <nav class="pager">
      {
        prev ? (
          <a href={`/posts/${prev.id}`} class="pg">
            <span class="mono">← 上一篇</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/posts/${next.id}`} class="pg right">
            <span class="mono">下一篇 →</span>
            <strong>{next.data.title}</strong>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  const bar = document.getElementById('progress')!;
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  };
  addEventListener('scroll', update, { passive: true });
  update();

  // TOC 高亮当前章节
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = links.map((a) => document.getElementById(a.dataset.slug!)).filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.dataset.slug === e.target.id));
      });
    },
    { rootMargin: '-90px 0px -70% 0px' },
  );
  heads.forEach((h) => io.observe(h));

  // 代码块复制按钮
  document.querySelectorAll('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'copy mono';
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
      btn.textContent = '已复制 ✓';
      setTimeout(() => (btn.textContent = '复制'), 1400);
    });
    const box = document.createElement('div');
    box.className = 'code-box';
    pre.replaceWith(box);
    box.append(pre, btn);
  });
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    z-index: 60;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  .post-head {
    max-width: 760px;
    padding: 56px 0 36px;
    margin-bottom: 40px;
    border-bottom: 2px solid var(--border);
  }

  .back {
    font-size: 14px;
    color: var(--ink-2);
  }

  .meta {
    display: flex;
    gap: 8px;
    margin-top: 28px;
    font-size: 13.5px;
    color: var(--accent);
  }

  h1 {
    margin: 10px 0 14px;
    font: 800 clamp(34px, 6vw, 56px) / 1.12 var(--font-display);
    letter-spacing: -0.035em;
  }

  .lead {
    margin: 0 0 18px;
    font-size: 19px;
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cover {
    width: 100%;
    margin-top: 32px;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 64px;
  }

  .toc {
    position: sticky;
    top: 110px;
    align-self: start;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    padding-left: 16px;
    border-left: 2px solid var(--line);
  }

  .toc-title {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 14px;
  }

  .toc .d3 {
    padding-left: 14px;
  }

  .toc a {
    position: relative;
    color: var(--muted);
    transition: color 0.2s;
  }

  .toc a:hover,
  .toc a.on {
    color: var(--ink);
  }

  .toc a.on::before {
    content: '';
    position: absolute;
    left: -19px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
  }

  .toc .d3 a.on::before {
    left: -33px;
  }

  .prose :global(.code-box) {
    position: relative;
  }

  .prose :global(.copy) {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 12px;
    padding: 3px 9px;
    border: 1.5px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .prose :global(.code-box:hover .copy) {
    opacity: 1;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 80px;
  }

  .pg {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 22px;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .pg:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--shadow-hover);
  }

  .pg span {
    font-size: 12px;
    color: var(--muted);
  }

  .pg.right {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .toc {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pg.right {
      grid-column: auto;
    }
  }
</style>
