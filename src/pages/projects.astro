---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0),
);
---

<Base title="项目" description="我做过的一些项目">
  <div class="wrap">
    <header class="page-head">
      <div class="kicker">// {projects.length} projects</div>
      <h1>项目<span style="color:var(--accent)">.</span></h1>
      <p>我做过的一些东西，有正经的，也有好玩的。</p>
    </header>

    {
      projects.length === 0 && (
        <div class="empty-state mono">
          <span>¯\_(ツ)_/¯</span>
          <p>还没有项目，正在动手做。</p>
        </div>
      )
    }

    <div class="grid">
      {
        projects.map((p, i) => (
          <a class="proj reveal" href={`/projects/${p.id}/`}>
            <div class="top mono">
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              {p.data.year && <span>{p.data.year}</span>}
            </div>
            <h2>{p.data.title}</h2>
            <p>{p.data.desc}</p>
            <div class="tech">
              {p.data.tech.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
            <div class="more mono">
              查看详情 <span class="go">→</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 28px;
  }

  .proj {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: 5px 5px 0 var(--shadow-c);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .proj:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--shadow-hover);
  }

  .top {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
  }

  .no {
    color: var(--accent);
    font-weight: 700;
  }

  h2 {
    margin: 0;
    font: 700 22px var(--font-display);
  }

  p {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .more {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    border-top: 1.5px dashed var(--line);
  }

  .go {
    color: var(--accent);
    transition: transform 0.2s;
  }

  .proj:hover .go {
    transform: translateX(4px);
  }
</style>
