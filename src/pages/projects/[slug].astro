---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, desc, tech, year, link, repo, cover } = entry.data;
---

<Base title={title} description={desc}>
  <div class="wrap">
    <div class="topbar">
      <a class="btn back" href="/projects/">← 返回项目</a>
    </div>

    <header class="page-head">
      <div class="kicker">// project{year ? ` · ${year}` : ''}</div>
      <h1>{title}</h1>
      <p>{desc}</p>
      {
        tech.length > 0 && (
          <div class="tags">
            {tech.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }
      {
        (link || repo || entry.id === 'kok') && (
          <div class="ext">
            {entry.id === 'kok' && (
              <a class="btn sub docs-btn" href="/docs/kok/">
                帮助中心 →
              </a>
            )}
            {repo && (
              <a class="btn gh" href={repo} target="_blank" rel="noreferrer">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
                GitHub 项目 ↗
              </a>
            )}
            {link && (
              <a class="btn sub" href={link} target="_blank" rel="noreferrer">
                下载 / 访问 ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {cover && <img class="cover" src={cover} alt="" />}

    <article class="prose">
      <Content />
    </article>

    <div class="bottom">
      <a class="btn" href="/projects/">← 返回项目</a>
    </div>
  </div>
</Base>

<style>
  .topbar {
    padding-top: 44px;
  }

  .back {
    padding: 9px 16px;
    font-size: 14px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .ext {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .ext .btn {
    padding: 9px 16px;
    font-size: 14px;
  }

  .ext .gh svg {
    flex: none;
  }

  .ext .sub {
    border-color: var(--line);
    box-shadow: none;
    color: var(--ink-2);
  }

  .cover {
    width: 100%;
    margin: 0 0 40px;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .prose {
    max-width: 820px;
  }

  .bottom {
    margin-top: 64px;
    padding-bottom: 8px;
  }
</style>
