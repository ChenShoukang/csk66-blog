---
import { getEntry, render } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';

const entry = await getEntry('docs', 'kok');
if (!entry) throw new Error('缺少 kok 帮助中心入口，请先运行 npm run sync:kok-help');

const { Content } = await render(entry);
---

<Docs title={entry.data.title} description={entry.data.description} current="/docs/kok/" isHome>
  <Content />
</Docs>
