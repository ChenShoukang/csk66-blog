---
import type { Post } from '../utils';
import { formatDate, readingTime, slugify, hueOf } from '../utils';

interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { title, date, tags, summary, cover } = post.data;
const url = `/posts/${post.id}`;
const hue = hueOf(post.id);
const no = String(index + 1).padStart(2, '0');
---

<article class="card reveal" style={`--h:${hue}`}>
  <a href={url} class="cover" aria-label={title}>
    {
      cover ? (
        <img src={cover} alt="" loading="lazy" />
      ) : (
        <div class="gen">
          <span class="gen-letter">{title.trim().charAt(0)}</span>
          <span class="gen-tag mono">#{tags[0] ?? 'note'}</span>
        </div>
      )
    }
    <span class="no mono">{no}</span>
  </a>
  <div class="body">
    <div class="meta mono">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span>/</span>
      <span>约 {readingTime(post.body)} 分钟</span>
    </div>
    <h2><a href={url}><span class="hl">{title}</span></a></h2>
    <div class="tags">{tags.map((t) => <a class="tag" href={`/tags/${slugify(t)}`}>#{t}</a>)}</div>
    {summary && <p class="sum">{summary}</p>}
    <a href={url} class="more mono"><span class="hl">阅读全文</span> <i>→</i></a>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 36px;
    align-items: center;
  }

  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.25s;
  }

  .cover:hover {
    transform: translate(-3px, -3px) rotate(-1deg);
    box-shadow: 10px 10px 0 var(--shadow-c);
  }

  :global(:root.dark) .cover:hover {
    box-shadow: 10px 10px 0 var(--shadow-hover);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .cover:hover img {
    transform: scale(1.05);
  }

  .gen {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 80% 20%, hsl(var(--h) 85% 72% / 0.9), transparent 55%),
      repeating-linear-gradient(-45deg, transparent 0 10px, hsl(var(--h) 40% 40% / 0.08) 10px 11px),
      hsl(calc(var(--h) + 30) 45% 88%);
  }

  :global(:root.dark) .gen {
    background:
      radial-gradient(circle at 80% 20%, hsl(var(--h) 70% 45% / 0.8), transparent 55%),
      repeating-linear-gradient(-45deg, transparent 0 10px, hsl(var(--h) 40% 70% / 0.06) 10px 11px),
      hsl(calc(var(--h) + 30) 25% 16%);
  }

  .gen-letter {
    position: absolute;
    left: 18px;
    bottom: -18px;
    font: 800 140px/1 var(--font-display);
    color: var(--ink);
    opacity: 0.88;
    transition: transform 0.4s;
  }

  .cover:hover .gen-letter {
    transform: translateY(-8px);
  }

  .gen-tag {
    position: absolute;
    right: 14px;
    bottom: 12px;
    font-size: 13px;
    padding: 2px 8px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 6px;
  }

  .no {
    position: absolute;
    top: 10px;
    left: 12px;
    font-size: 12px;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 5px;
    background: var(--paper);
    color: var(--ink);
    border: 1.5px solid var(--border);
  }

  .meta {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  h2 {
    margin: 6px 0 10px;
    font: 700 clamp(22px, 3vw, 28px) / 1.3 var(--font-display);
    letter-spacing: -0.02em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sum {
    margin: 12px 0 14px;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more {
    font-size: 14px;
    font-weight: 600;
  }

  .more i {
    display: inline-block;
    font-style: normal;
    color: var(--accent);
    transition: transform 0.25s;
  }

  .more:hover i {
    transform: translateX(5px);
  }

  @media (max-width: 760px) {
    .card {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
