---
import { NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header" id="site-header">
  <a href="/" class:list={['home', { active: path === '/' }]}>主页</a>

  <nav class="nav" aria-label="Main">
    {
      NAV.map((n) => (
        <a
          href={n.href}
          class:list={['nav-link', { active: isActive(n.href) }]}
          aria-current={isActive(n.href) ? 'page' : undefined}
        >
          {n.label}
        </a>
      ))
    }
  </nav>

  <div class="actions">
    <button class="icon-btn" id="search-open" aria-label="Search (Ctrl+K)" title="搜索 Ctrl+K">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <kbd id="kbd-hint">Ctrl K</kbd>
    </button>
    <button class="icon-btn" id="theme-toggle" aria-label="Toggle theme" title="切换主题">
      <svg class="sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    </button>
    <button class="icon-btn burger" id="menu-toggle" aria-label="Menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" hidden>
  {NAV.map((n, i) => <a href={n.href} style={`--i:${i}`}>{n.label}</a>)}
</div>

<style>
  .site-header {
    position: sticky;
    top: 16px;
    z-index: 50;
    width: calc(100% - 32px);
    max-width: calc(var(--wrap) - 16px);
    margin: 16px auto 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 999px;
    border: 1.5px solid color-mix(in srgb, var(--ink) 14%, transparent);
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.25s, border-color 0.25s;
  }

  .site-header.scrolled {
    border-color: var(--border);
    box-shadow: 4px 4px 0 var(--shadow-c);
  }





  .home {
    justify-self: start;
    padding: 8px 16px;
    border-radius: 999px;
    font: 700 16px var(--font-display);
    letter-spacing: 0.08em;
    color: var(--ink);
    transition: background 0.2s, color 0.2s;
  }

  .home:hover,
  .home.active {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
  }

  .nav {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    border: none;
    background: none;
    color: var(--ink-2);
    font: 600 13.5px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 999px;
    transition: color 0.2s, background 0.2s;
  }

  .nav-link:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }

  .nav-link.active {
    color: var(--ink);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .actions {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    min-width: 38px;
    justify-content: center;
    padding: 0 9px;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--ink);
    transition: background 0.2s, transform 0.2s;
  }

  .icon-btn:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .icon-btn kbd {
    font: 600 11px var(--font-mono);
    padding: 1px 6px;
    border: 1.5px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
  }

  #theme-toggle:active {
    transform: rotate(40deg);
  }

  :global(:root.dark) .sun,
  :global(:root:not(.dark)) .moon {
    display: none;
  }

  .burger {
    display: none;
  }

  .mobile-nav {
    position: fixed;
    inset: 80px 16px auto;
    z-index: 49;
    display: grid;
    gap: 4px;
    padding: 12px;
    border: 2px solid var(--border);
    border-radius: 18px;
    background: var(--card);
    box-shadow: 5px 5px 0 var(--shadow-c);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav a {
    padding: 12px 14px;
    border-radius: 10px;
    font: 600 17px var(--font-mono);
    text-transform: uppercase;
    animation: drop 0.3s calc(var(--i) * 40ms) both;
  }

  .mobile-nav a:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (max-width: 760px) {
    .nav,
    .icon-btn kbd {
      display: none;
    }
    .burger {
      display: inline-flex;
    }
  }
</style>

<script>
  // Mac 上显示 ⌘K，其他系统显示 Ctrl K
  if (/Mac|iPhone|iPad/.test(navigator.platform)) document.getElementById('kbd-hint')!.textContent = '⌘K';

  const header = document.getElementById('site-header')!;
  const onScroll = () => header.classList.toggle('scrolled', scrollY > 40);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    const apply = () => {
      document.documentElement.classList.toggle('dark', dark);
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    };
    // 支持时用 View Transition 做圆形扩散切换
    const d = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    d.startViewTransition ? d.startViewTransition(apply) : apply();
  });

  const menu = document.getElementById('mobile-nav')!;
  document.getElementById('menu-toggle')!.addEventListener('click', () => (menu.hidden = !menu.hidden));
</script>
